# Local editor password for `npm run dev` only. Never put this (or any real
# production secret) in a VITE_ variable — those are inlined into the JS bundle.
# Production PHP rejects placeholders and passwords shorter than 16 characters.
# When GOOGLE_CLIENT_ID is set, password login is disabled.
EDIT_PASSWORD=local-dev-only

# Google Sign-In for the editor. The live /admin button reads Hostinger
# api/config.php via /api/google.php. VITE_GOOGLE_CLIENT_ID is only a fallback
# for local/static preview. Create an OAuth 2.0 "Web application" client at
# https://console.cloud.google.com/apis/credentials
# Origins: http://localhost:5173, http://tygrventures.com, https://tygrventures.com
# Redirect URIs: those same hosts with /admin
# Leaving the client ID blank keeps the local password login.
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# Comma-separated Google accounts allowed to edit the site.
# An empty list denies every account.
VITE_GOOGLE_ALLOWED_EMAILS=rasheq@tygrventures.com
GOOGLE_ALLOWED_EMAILS=rasheq@tygrventures.com

# 21st.dev MCP (Cursor reads this from the environment for .cursor/mcp.json).
# Create a key at https://21st.dev/settings/api-keys
API_KEY_21ST=

# Optional. Create a free Unsplash app and paste the Access Key to enable photo search.
# https://unsplash.com/developers
VITE_UNSPLASH_ACCESS_KEY=

# Optional Calendly (or other) booking URL used by "Book a call" buttons.
VITE_BOOKING_URL=

# TidyCal REST API (custom booking widget on the contact section).
# Personal Access Token from https://tidycal.com/integrations/advanced ->
# "Manage API keys" (paid plan). Stays server-side; the browser only calls
# /api/tidycal.php. Leave blank locally to preview the widget with mock times.
# On Hostinger, set the same values in public/api/config.php.
TIDYCAL_TOKEN=
# Booking type the scheduler uses (digits only). Find it via GET https://tidycal.com/api/booking-types.
TIDYCAL_BOOKING_TYPE_ID=
