# Local + Hostinger edit gate. Never commit a production secret.
# Copy to .env for `npm run dev`. On Hostinger, copy public/api/config.sample.php
# to public/api/config.php (or set the same value in the PHP file).
EDIT_PASSWORD=change-me

# Optional client-side fallback used only when /api/auth.php is unavailable (pure static preview).
# Must match EDIT_PASSWORD. Do not ship a real production password in a public build.
VITE_EDIT_PASSWORD=change-me

# Google Sign-In for the editor (lightweight, no OAuth server flow).
# Create an OAuth 2.0 "Web application" client at
# https://console.cloud.google.com/apis/credentials and add your site origins
# (e.g. http://localhost:5173 and https://tygrventures.com) as Authorized
# JavaScript origins. Paste the client ID below. Leaving it blank keeps the
# password login. The same values belong in public/api/config.php on Hostinger.
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# Comma-separated Google accounts allowed to edit the site.
VITE_GOOGLE_ALLOWED_EMAILS=rasheq@tygrventures.com
GOOGLE_ALLOWED_EMAILS=rasheq@tygrventures.com

# Optional. Create a free Unsplash app and paste the Access Key to enable photo search.
# https://unsplash.com/developers
VITE_UNSPLASH_ACCESS_KEY=

# Optional Calendly (or other) booking URL used by "Book a call" buttons.
VITE_BOOKING_URL=
